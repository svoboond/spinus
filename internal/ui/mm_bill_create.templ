package ui

import (
	"fmt"
	"strconv"
)

func getBeginDateID(i int) string {
	return fmt.Sprintf("begin-date-%d", i)
}

func getEndDateID(i int) string {
	return fmt.Sprintf("end-date-%d", i)
}

func getBeginRdgValID(i int) string {
	return fmt.Sprintf("begin-rdg-val-%d", i)
}

func getEndRdgValID(i int) string {
	return fmt.Sprintf("end-rdg-val-%d", i)
}

func getConsumEnergyPriceID(i int) string {
	return fmt.Sprintf("consum-energy-price-%d", i)
}

func getServicePriceID(i int) string {
	return fmt.Sprintf("service-price-%d", i)
}

templ MmBillCreate(
	upper MmUpperTmpl,
	mmBillForm MmBillForm,
	mmBillPeriods []*MmBillPeriodForm,
	smBillForms SmBillForms,
	calculated bool) {
	@MmUpper(upper)
	<h1>New Billing</h1>
	<form method="post">
		if mmBillForm.GeneralErr != "" {
			<span class="error">{ mmBillForm.GeneralErr }</span>
		}
		<label for="max-day-diff">Maximum Day Difference (Required)</label>
		<input
			type="number"
			name="max-day-diff"
			id="max-day-diff"
			min="1"
			max="255"
			required
			value={ mmBillForm.MaxDayDiff }
		/>
		if mmBillForm.MaxDayDiffErr != "" {
			<label class="error" for="meter-identification">{ mmBillForm.MaxDayDiffErr }</label>
		}
		for i, mmBillPeriod := range mmBillPeriods {
			<fieldset>
				<h3>Billing Period { strconv.Itoa(i+1) }</h3>
				<label for={ getBeginDateID(i) }>Begin Date (Required)</label>
				<input
					type="date"
					name="begin-date"
					id="{ getBeginDateID(i) }"
					required
					value={ mmBillPeriod.BeginDate }
				/>
				if mmBillPeriod.BeginDateErr != "" {
					<label class="error" for={ getBeginDateID(i) }>{ mmBillPeriod.BeginDateErr }</label>
				}
				<label for={ getEndDateID(i) }>End Date (Required)</label>
				<input
					type="date"
					name="end-date"
					id="{ getEndDateID(i) }"
					required
					value={ mmBillPeriod.EndDate }
				/>
				if mmBillPeriod.EndDateErr != "" {
					<label class="error" for={ getEndDateID(i) }>{ mmBillPeriod.EndDateErr }</label>
				}
				<label for={ getBeginRdgValID(i) }>Begin Reading Value (Required)</label>
				<input
					type="number"
					step="0.001"
					name="begin-rdg-val"
					id="{ getBeginRdgValID(i) }"
					min="0"
					required
					value={ mmBillPeriod.BeginRdgVal }
				/>
				if mmBillPeriod.BeginRdgValErr != "" {
					<label class="error" for={ getBeginRdgValID(i) }>{ mmBillPeriod.BeginRdgValErr }</label>
				}
				<label for={ getEndRdgValID(i) }>End Reading Value (Required)</label>
				<input
					type="number"
					step="0.001"
					name="end-rdg-val"
					id="{ getEndRdgValID(i) }"
					min="0"
					required
					value={ mmBillPeriod.EndRdgVal }
				/>
				if mmBillPeriod.EndRdgValErr != "" {
					<label class="error" for={ getEndRdgValID(i) }>{ mmBillPeriod.EndRdgValErr }</label>
				}
				<label for={ getConsumEnergyPriceID(i) }>Consumed Energy Price (Required)</label>
				<input
					type="number"
					step="0.001"
					name="consum-energy-price"
					id="{ getConsumEnergyPriceID(i) }"
					min="0"
					required
					value={ mmBillPeriod.ConsumEnergyPrice }
				/>
				if mmBillPeriod.ConsumEnergyPriceErr != "" {
					<label class="error" for={ getConsumEnergyPriceID(i) }>{ mmBillPeriod.ConsumEnergyPriceErr }</label>
				}
				<label for={ getServicePriceID(i) }>Service Price</label>
				<input
					type="number"
					step="0.001"
					name="service-price"
					id="{ getServicePriceID(i) }"
					min="0"
					required
					value={ mmBillPeriod.ServicePrice }
				/>
				if mmBillPeriod.ServicePriceErr != "" {
					<label class="error" for={ getServicePriceID(i) }>{ mmBillPeriod.ServicePriceErr }</label>
				}
			</fieldset>
		}
		<input
			type="submit"
			name="add-bill-period"
			value="Add Billing Period"
			formnovalidate
		/>
		<input
			type="submit"
			name="remove-bill-period"
			value="Remove Billing Period"
			formnovalidate
		/>
		if len(smBillForms) > 0 {
			<table>
				<tr>
					<th>Meter Identification</th>
					<th>User Email</th>
					<th>Energy Consumption</th>
					<th>Consumed Energy Price</th>
					<th>Service Price</th>
					<th>Advance Price</th>
					<th>From Financial Balance</th>
					<th>To Pay</th>
				</tr>
				for _, smBillForm := range smBillForms {
					<tr>
						<td>{ smBillForm.MeterID }</td>
						<td>{ smBillForm.Email }</td>
						<td>{ strconv.FormatFloat(smBillForm.EnergyConsum , 'f', -1, 64) }</td>
						<td>{ strconv.FormatFloat(smBillForm.ConsumEnergyPrice , 'f', -1, 64) }</td>
						if smBillForm.ServicePrice.Valid {
							<td>{ strconv.FormatFloat(smBillForm.ServicePrice.Float64, 'f', -1, 64) }</td>
						} else {
							<td></td>
						}
						<td>{ strconv.FormatFloat(smBillForm.AdvancePrice , 'f', -1, 64) }</td>
						<td>{ strconv.FormatFloat(smBillForm.FromFinBalance , 'f', -1, 64) }</td>
						<td>{ strconv.FormatFloat(smBillForm.ToPay , 'f', -1, 64) }</td>
					</tr>
				}
			</table>
		}
		<input type="submit" name="calculate-bill" value="Calculate"/>
		<input
			type="submit"
			name="create-bill"
			value="Create"
			if !calculated {
				disabled
			}
		/>
	</form>
}
